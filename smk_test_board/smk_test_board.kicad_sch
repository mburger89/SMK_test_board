  (text "KEY MATRIX  3x3  (one 1N4148 per key; R0C2 is the EC11 push switch)" (exclude_from_sim no) (at 15.24 13.97 0) (effects (font (size 2.0 2.0) (thickness 0.3) bold) (justify left bottom)) (uuid "a06ca3a9-9844-5e22-b579-7950aa991e47"))
